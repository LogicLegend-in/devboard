# ==============================================================================
# DevBoard Environment Configuration
# Copy this file to .env and customize for your deployment environment.
# ==============================================================================

# Server Network Settings
PORT=8004
HOST=0.0.0.0
ENVIRONMENT=production
WORKERS=2

# Database Connection
# SQLite default (zero-configuration local & container persistence):
DATABASE_URL=sqlite:///./devboard.db
# PostgreSQL / Supabase / Neon / Render production example:
# DATABASE_URL=postgresql://devboard_user:password@localhost:5432/devboard

# Database Pool Settings (applicable when using PostgreSQL)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800

# CORS Allowed Origins
# Use * for open access, or comma-separated domains (e.g. https://devboard.logiclegend.in,https://logiclegend.in)
CORS_ORIGINS=*

# Optional GitHub Integration
# If set, DevBoard can synchronize live commit, PR, and workflow data from GitHub API.
# Generate a token with 'repo' scope at: https://github.com/settings/tokens
GITHUB_TOKEN=
